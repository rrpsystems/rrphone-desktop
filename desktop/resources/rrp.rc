// Ícone embutido no executável.
//
// QIcon/setWindowIcon() só valem em tempo de execução, dentro do processo. O
// Explorer, o atalho da área de trabalho e o botão da barra de tarefas leem o
// ícone do arquivo .exe — sem este recurso eles mostram o ícone genérico do
// Windows, mesmo com a janela e a bandeja exibindo a logo corretamente.
//
// O menor ID numérico é o que o shell do Windows adota como ícone do
// aplicativo, então este precisa ser o primeiro.
#define IDI_APPICON 1
IDI_APPICON ICON "rrp.ico"
